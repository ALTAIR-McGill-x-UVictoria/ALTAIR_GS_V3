# Copy this file to .env and replace the placeholders. Never commit .env.
ALTAIR_STATION_ID=REPLACE_WITH_STATION_ID

# Shared operator token required for any control action (arm, telescope,
# camera, radio config, system restart) when set. Leave unset for trusted
# local-only use; REQUIRED before exposing this backend publicly (e.g. via
# the Cloudflare Tunnel in /etc/cloudflared/config.yml) since GET routes and
# the telemetry WebSocket are otherwise open to anyone who can reach it.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ALTAIR_ADMIN_TOKEN=REPLACE_WITH_RANDOM_TOKEN
ALTAIR_REMOTE_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://REPLACE_WITH_GRAFANA_OTLP_ENDPOINT/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20REPLACE_WITH_BASE64_CREDENTIALS

# Optional: connect to the flight computer's telemetry tee over the network
# (e.g. its ZeroTier IP) as an automatic failover when radio is unavailable
# but the FC has internet. Leave ALTAIR_TUNNEL_HOST unset to disable — the
# FC side also needs [telemetry_tee] enabled=true in its settings.toml.
# ALTAIR_TUNNEL_HOST=REPLACE_WITH_FC_ZEROTIER_IP
# ALTAIR_TUNNEL_PORT=5760
