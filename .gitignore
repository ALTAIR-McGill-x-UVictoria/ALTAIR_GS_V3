# JS dependencies — reinstall with: npm install
node_modules/

# Vite build output
dist/
dist-ssr/

# Python
__pycache__/
*.pyc
.venv/
.env
.env.local

# Runtime binaries (obtain separately — see backend/lib/README.md)
backend/lib/*.dll
backend/lib/*.so
backend/lib/*.so.*
backend/lib/*.dylib

# Telemetry log sessions (keep the logs/ dir itself via .gitkeep)
logs/*/

# Camera captures (test/session output, not source) — recursive, so
# subdirectories like captures/2026-08-19/tests/ are excluded too, not just
# files directly under captures/. See git history: 343e280 previously slipped
# ~100MB+ of FITS/CR2 into a commit because this only matched the top level.
captures/**/*.fits
captures/**/*.cr2
captures/**/*.jpg
captures/**/*.jpeg
captures/**/*.tiff
captures/**/*.tif

# Calibration tab output (test/session output, not source) — each capture's
# own subdirectory under calibration_logs/, same reasoning as captures/ above.
calibration_logs/**

# Editor
.vscode/
.idea/
.claude/
